--Задание 1: Вывести полный список читателей
SELECT *
FROM readers;

--Задание 2: Вывести названия книг и годы издания
SELECT title, publication_year
FROM books;

--Задание 3: Найти книги XIX века
SELECT title, publication_year
FROM books
WHERE publication_year BETWEEN 1801 AND 1900;

--Задание 4: Найти книги советского периода
SELECT *
FROM books
WHERE publication_year BETWEEN 1917 AND 1991;

--Задание 5: Найти читателя по номеру телефона
SELECT *
FROM readers
WHERE telephone = '+7-900-333-44-55';

--Задание 6: Найти читателей по фрагменту ФИО
SELECT *
FROM readers
WHERE  full_name LIKE '%ва%';

--Задание 7: Найти активные выдачи
SELECT *
FROM loans
WHERE actual_return_date  IS  NULL;

--Задание 8: Отсортировать книги по названию
SELECT title, publication_year
FROM books
ORDER BY title;

--Задание 9: Показать ближайшие плановые возвраты
SELECT *
FROM loans
WHERE actual_return_date IS NULL
ORDER BY planned_return_date;

--Задание 10: Найти ограниченный набор книг
SELECT *
FROM books
ORDER BY title
LIMIT 3;
